<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.mfo.instagramclone.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_loginActivity"
            app:destination="@id/loginActivity" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.mfo.instagramclone.ui.search.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_searchFragment_to_loginActivity"
            app:destination="@id/loginActivity" />
        <action
            android:id="@+id/action_searchFragment_to_searchDetailFragment"
            app:destination="@id/searchDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.mfo.instagramclone.ui.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_postDetailActivity"
            app:destination="@id/postDetailFragment" />
        <action
            android:id="@+id/action_profileFragment_to_loginActivity"
            app:destination="@id/loginActivity" />
        <action
            android:id="@+id/action_profileFragment_to_followFragment"
            app:destination="@id/followFragment" />
        <action
            android:id="@+id/action_profileFragment_to_followFragment2"
            app:destination="@id/followFragment" />
        <action
            android:id="@+id/action_profileFragment_to_settingFragment"
            app:destination="@id/settingFragment" />
    </fragment>
    <fragment
        android:id="@+id/postDetailFragment"
        android:name="com.mfo.instagramclone.ui.postDetail.PostDetailFragment"
        android:label="Post"
        tools:layout="@layout/fragment_post_detail" >
        <argument
            android:name="postId"
            app:argType="long" />
        <action
            android:id="@+id/action_postDetailFragment_to_loginActivity"
            app:destination="@id/loginActivity" />
        <action
            android:id="@+id/action_postDetailFragment_to_followFragment"
            app:destination="@id/followFragment" />
    </fragment>
    <activity
        android:id="@+id/loginActivity"
        android:name="com.mfo.instagramclone.ui.login.LoginActivity"
        android:label="activity_login"
        tools:layout="@layout/activity_login" />
    <fragment
        android:id="@+id/searchDetailFragment"
        android:name="com.mfo.instagramclone.ui.search.SearchDetailFragment"
        android:label="search user"
        tools:layout="@layout/fragment_search_detail" >
        <action
            android:id="@+id/action_searchDetailFragment_to_loginActivity"
            app:destination="@id/loginActivity" />
        <action
            android:id="@+id/action_searchDetailFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment" />
    </fragment>
    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.mfo.instagramclone.ui.userProfile.UserProfileFragment"
        android:label= "@string/label_user_profile"
        tools:layout="@layout/fragment_user_profile" >
        <argument
            android:name="userId"
            app:argType="long" />
        <argument
            android:name="userName"
            app:argType="string" />
        <action
            android:id="@+id/action_userProfileFragment_to_followFragment"
            app:destination="@id/followFragment" />
    </fragment>
    <fragment
        android:id="@+id/followFragment"
        android:name="com.mfo.instagramclone.ui.follow.FollowFragment"
        android:label="fragment_follow"
        tools:layout="@layout/fragment_follow" >
        <argument
            android:name="userId"
            app:argType="long" />
        <argument
            android:name="label"
            app:argType="string" />
        <action
            android:id="@+id/action_followFragment_to_loginActivity"
            app:destination="@id/loginActivity" />
        <action
            android:id="@+id/action_followFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment" />
    </fragment>
    <fragment
        android:id="@+id/postActionFragment"
        android:name="com.mfo.instagramclone.ui.postActions.PostActionFragment"
        android:label="fragment_post_action"
        tools:layout="@layout/fragment_post_action" >
        <argument
            android:name="label"
            app:argType="string" />
        <action
            android:id="@+id/action_postActionFragment_to_loginActivity"
            app:destination="@id/loginActivity" />
        <action
            android:id="@+id/action_postActionFragment_to_postDetailFragment"
            app:destination="@id/postDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.mfo.instagramclone.ui.setting.SettingFragment"
        android:label="Settings and activity"
        tools:layout="@layout/fragment_setting" >
        <action
            android:id="@+id/action_settingFragment_to_postActionFragment"
            app:destination="@id/postActionFragment" />
        <action
            android:id="@+id/action_settingFragment_to_loginActivity"
            app:destination="@id/loginActivity" />
    </fragment>
</navigation>